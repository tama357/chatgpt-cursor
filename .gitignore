# 秘密情報・認証
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
*secret*
*password*
*apikey*
*api_key*

# 依存関係
node_modules/
__pycache__/
*.py[cod]

# 競輪予想の内部学習データ（公開リポジトリへ保存しない）
競輪予想/state/*.json
!競輪予想/state/*.example.json
競輪予想/data/**/*
!競輪予想/data/.gitkeep

# 個人予想の実行データ（公開リポジトリへ保存しない）
個人予想/data/**/*
!個人予想/data/.gitkeep
個人予想/excel/_e2e_test/
個人予想/.drive/
個人予想/tests/e2e_excel_test_report.json

# YouTubeショート作業ファイル（完成MP4は残す）
youtube-shorts/assets/cache/
youtube-shorts/assets/work/
youtube-shorts/**/__pycache__/

# 泥ママ制作ガイドの全フレーム測定画像（代表画面だけ残す）
outputs/doromama-storyland-guide/screenshots/01_hai/
