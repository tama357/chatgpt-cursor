# 秘密情報・認証
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
*secret*
*password*
*apikey*
*api_key*

# 依存関係
node_modules/
__pycache__/
*.py[cod]

# 競輪予想の内部学習データ（公開リポジトリへ保存しない）
